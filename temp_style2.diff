+  border-color: #FF6B35;
+  outline: 2px solid #FF6B35;
+  outline-offset: -2px;
+}
+
+.annotation-text-bar-input::placeholder {
+  color: #6e7681;
+}
+
+.annotation-text-bar-confirm {
+  padding: 5px 14px;
+  font-size: 13px;
+  font-weight: 600;
+  color: #fff;
+  background: #FF6B35;
+  border: none;
+  border-radius: 6px;
+  cursor: pointer;
+  transition: background 0.15s;
+}
+
+.annotation-text-bar-confirm:hover {
+  background: #e85d2c;
+}
+
+.annotation-text-bar-cancel {
+  padding: 5px 10px;
+  font-size: 13px;
+  font-weight: 500;
+  color: #828B94;
+  background: transparent;
+  border: none;
+  border-radius: 6px;
+  cursor: pointer;
+  transition: background 0.15s, color 0.15s;
+}
+
+.annotation-text-bar-cancel:hover {
+  background: rgba(255, 255, 255, 0.08);
+  color: #fff;
+}
+
+/* 文字工具提示：点击截图放置文字 */
+.annotation-text-hint {
+  margin-left: 8px;
+  padding: 6px 12px;
+  font-size: 12px;
+  color: #828B94;
+  background: #333840;
+  border-radius: 6px;
+  white-space: nowrap;
+}
+
+/* 标注颜色 / 大小设置 */
+.annotation-settings {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  margin-left: 8px;
+  padding-left: 16px;
+  border-left: 1px solid #333840;
+}
+
+.annotation-setting-group {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.annotation-setting-label {
+  font-size: 12px;
+  color: #828B94;
+  white-space: nowrap;
+}
+
+.annotation-colors {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+}
+
+.annotation-color-swatch {
+  width: 20px;
+  height: 20px;
+  border-radius: 50%;
+  border: 2px solid transparent;
+  cursor: pointer;
+  padding: 0;
+  transition: transform 0.12s, border-color 0.12s;
+}
+
+.annotation-color-swatch:hover {
+  transform: scale(1.15);
+}
+
+.annotation-color-swatch.active {
+  border-color: #fff;
+  box-shadow: 0 0 0 2px #FF6B35;
+}
+
+.annotation-sizes {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+}
+
+.annotation-size-btn {
+  min-width: 28px;
+  height: 28px;
+  padding: 0 8px;
+  font-size: 12px;
+  font-weight: 500;
+  color: #828B94;
+  background: #333840;
+  border: 1px solid transparent;
+  border-radius: 6px;
+  cursor: pointer;
+  transition: background 0.15s, color 0.15s, border-color 0.15s;
+}
+
+.annotation-size-btn:hover {
+  background: #3d444d;
+  color: #fff;
+}
+
+.annotation-size-btn.active {
+  color: #fff;
+  background: #FF6B35;
+  border-color: #FF6B35;
+}
+
+/* ===== 文字浮层（桌面端：点击图片位置弹出，含字号+输入+确认/取消） ===== */
+.annotation-text-popover {
+  position: absolute;
+  z-index: 20;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  min-width: 240px;
+  padding: 10px;
+  background: #24292E;
+  border: 1px solid #333840;
+  border-radius: 10px;
+  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
+}
+.annotation-text-popover-fonts {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  flex-wrap: wrap;
+}
+.annotation-text-popover-fonts button {
+  min-width: 32px;
+  height: 28px;
+  padding: 0 6px;
+  font-size: 12px;
+  font-weight: 500;
+  color: #828B94;
+  background: #333840;
+  border: 1px solid transparent;
+  border-radius: 6px;
+  cursor: pointer;
+  transition: background 0.15s, color 0.15s, border-color 0.15s;
+}
+.annotation-text-popover-fonts button:hover {
+  background: #3d444d;
+  color: #fff;
+}
+.annotation-text-popover-fonts button.active {
+  color: #fff;
+  background: #FF6B35;
+  border-color: #FF6B35;
+}
+.annotation-text-popover-row {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+}
+.annotation-text-popover-input {
+  flex: 1;
+  min-width: 0;
+  height: 32px;
+  padding: 0 10px;
+  font-size: 13px;
+  color: #fff;
+  background: #232830;
+  border: 1px solid #3d444d;
+  border-radius: 6px;
+  outline: none;
+  transition: border-color 0.15s;
+}
+.annotation-text-popover-input:focus {
+  border-color: #FF6B35;
+}
+.annotation-text-popover-confirm {
+  width: 32px;
+  height: 32px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 14px;
+  font-weight: 600;
+  color: #fff;
+  background: #FF6B35;
+  border: none;
+  border-radius: 6px;
+  cursor: pointer;
+  transition: background 0.15s;
+}
+.annotation-text-popover-confirm:hover {
+  background: #e85d2c;
+}
+.annotation-text-popover-cancel {
+  width: 32px;
+  height: 32px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 14px;
+  color: #828B94;
+  background: transparent;
+  border: none;
+  border-radius: 6px;
+  cursor: pointer;
+  transition: background 0.15s, color 0.15s;
+}
+.annotation-text-popover-cancel:hover {
+  background: rgba(255, 255, 255, 0.08);
+  color: #fff;
+}
